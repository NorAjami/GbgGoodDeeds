@model GbgGoodDeeds.Domain.Models.GoodDeed

@{
    ViewData["Title"] = "Dagens Goda Gärning";
}

<h2 class="text-primary">💡 Vad kan du göra idag?</h2>
<p class="text-light fst-italic">
  "Ingen kan göra allt – men alla kan göra något i sin del av Göteborg." 💙
</p>


@if (Model == null)
{
    <p>Inga gärningar tillgängliga. Lägg till en i databasen.</p>
}
else
{
    <div class="card p-4 shadow">
        <h4>@Model.Title</h4>
        <p>@Model.Description</p>

        @if (!Model.IsCompleted)
        {
            <form asp-action="MarkAsCompleted" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary">
                    ✅ Jag har gjort detta!
                </button>
            </form>
            <div class="card shadow p-4">
                <h3 class="text-primary">💡 @Model.Title</h3>
                <p>@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.Neighborhood))
                {
                    <p><span class="badge bg-info text-dark">@Model.Neighborhood</span></p>
                }

                <small class="text-muted">📅 Skapad: @Model.CreatedAt.ToShortDateString()</small>
            </div>

        }
        else
        {
            <p class="text-success mt-3 fw-bold">✅ Done! du har gjort Göteborg bättre!</p>
        }

        @if (!string.IsNullOrEmpty(Model.Neighborhood))
        {
            <p><strong>Område:</strong> @Model.Neighborhood</p>
        }
        <p><em>Skapad: @Model.CreatedAt.ToShortDateString()</em></p>
    </div>
}
